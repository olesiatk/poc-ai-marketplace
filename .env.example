# Copy this file to .env for local development (`npm start`, `npm run record:ai`, …).
# In Azure these same settings go into the Static Web App's environment variables
# (the /api function reads them) — never into the frontend build.

# From the Azure AI Foundry resource: Keys and Endpoint.
# Without them the app still works: AI search falls back to local synonym search.
AZURE_OPENAI_ENDPOINT=https://poc-marketplace-search-openai.openai.azure.com
AZURE_OPENAI_API_KEY=
# The model deployment's name in Foundry.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Build-time, not secret: the deployment's tokens-per-minute limit, so the browser
# paces live AI searches to fit it (one search reserves ~4.8K tokens).
AI_TOKENS_PER_MINUTE=50000
